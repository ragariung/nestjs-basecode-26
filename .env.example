# App
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Primary database (PostgreSQL 18) — actively used by the app
DATABASE_URL_POSTGRES=postgresql://username:password@localhost:50501/database?schema=public

# Example connections (not wired into AppModule by default)
DATABASE_URL_MYSQL=mysql://username:password@localhost:50502/database
DATABASE_URL_MONGO=mongodb://username:password@localhost:50500/database?authSource=admin
DATABASE_URL_COCKROACH=postgresql://username:password@localhost:50503/defaultdb?sslmode=disable
